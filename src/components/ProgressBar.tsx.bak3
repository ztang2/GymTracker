import React, { useEffect, useRef } from 'react';
import { useTheme } from '../contexts';
import { View, Text, StyleSheet, Animated } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import { typography, spacing, borderRadius } from '../constants/theme';

interface ProgressBarProps {
  // Label mode (original)
  label?: string;
  current?: number;
  target?: number;
  showPercentage?: boolean;
  unit?: string;
  // Simple mode (new)
  progress?: number; // 0-1 progress value
  height?: number;
  backgroundColor?: string;
  gradientColors?: readonly [string, string, ...string[]];
  // Common
  color?: string | readonly [string, string, ...string[]];
}

const ProgressBar: React.FC<ProgressBarProps> = ({
  label,
  current = 0,
  target = 100,
  color,
  showPercentage = true,
  unit = '',
  progress,
  height = 8,
  backgroundColor,
  gradientColors,
}) => {
  const { colors } = useTheme();
  const barColor = color || colors.gradientPurplePink;
  const styles = createStyles(colors);
  const animatedWidth = useRef(new Animated.Value(0)).current;

  // Use progress if provided, otherwise calculate from current/target
  const percentage = progress !== undefined
    ? progress * 100
    : (target > 0 ? Math.min((current / target) * 100, 100) : 0);

  // Use gradientColors if provided, otherwise use color
  const barColor = gradientColors || color;

  useEffect(() => {
    Animated.timing(animatedWidth, {
      toValue: percentage,
      duration: 800,
      useNativeDriver: false,
    }).start();
  }, [percentage]);

  const isGradient = Array.isArray(barColor);
  const isSimpleMode = !label;

  // Simple mode - just the bar without labels
  if (isSimpleMode) {
    return (
      <View style={[styles.track, { height, backgroundColor: backgroundColor || colors.border }]}>
        <Animated.View
          style={[
            styles.fillContainer,
            {
              width: animatedWidth.interpolate({
                inputRange: [0, 100],
                outputRange: ['0%', '100%'],
              }),
            },
          ]}
        >
          {isGradient ? (
            <LinearGradient
              colors={barColor as readonly [string, string, ...string[]]}
              start={{ x: 0, y: 0 }}
              end={{ x: 1, y: 0 }}
              style={[styles.fill, { height }]}
            />
          ) : (
            <View style={[styles.fill, { height, backgroundColor: barColor as string }]} />
          )}
        </Animated.View>
      </View>
    );
  }

  // Label mode - with labels and percentage
  return (
    <View style={styles.container}>
      <View style={styles.labelRow}>
        <Text style={styles.label}>{label}</Text>
        {showPercentage ? (
          <Text style={styles.value}>{Math.round(percentage)}%</Text>
        ) : (
          <Text style={styles.value}>
            {current}/{target} {unit}
          </Text>
        )}
      </View>

      <View style={styles.trackContainer}>
        <View style={[styles.track, { height }]}>
          <Animated.View
            style={[
              styles.fillContainer,
              {
                width: animatedWidth.interpolate({
                  inputRange: [0, 100],
                  outputRange: ['0%', '100%'],
                }),
              },
            ]}
          >
            {isGradient ? (
              <LinearGradient
                colors={barColor as readonly [string, string, ...string[]]}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 0 }}
                style={[styles.fill, { height }]}
              />
            ) : (
              <View style={[styles.fill, { height, backgroundColor: barColor as string }]} />
            )}
          </Animated.View>
        </View>
      </View>
    </View>
  );
};

const createStyles = (colors: any) => StyleSheet.create({
  container: {
    marginVertical: spacing.sm,
  },
  labelRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
    alignItems: 'center',
    marginBottom: spacing.sm,
  },
  label: {
    ...typography.callout,
    color: colors.textPrimary,
  },
  value: {
    ...typography.callout,
    fontWeight: '600',
    color: colors.purpleLight,
  },
  trackContainer: {
    width: '100%',
  },
  track: {
    height: 8,
    backgroundColor: colors.border,
    borderRadius: borderRadius.full,
    overflow: 'hidden',
  },
  fillContainer: {
    height: '100%',
  },
  fill: {
    height: '100%',
    borderRadius: borderRadius.full,
  },
});

export default ProgressBar;
